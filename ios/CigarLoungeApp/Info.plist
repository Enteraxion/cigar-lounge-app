<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Lounge Locator</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Google Sign-In redirect. Google opens a browser to authenticate and hands
	     the result back by opening this scheme, so without it the sign-in starts,
	     succeeds, and then never returns to the app.

	     The value is GoogleService-Info.plist's REVERSED_CLIENT_ID. That file is
	     gitignored because it carries the project's config, but this identifier is
	     deliberately duplicated here into a committed file: it is a public client
	     identifier, extractable from any installed copy of the app, and Apple
	     requires it declared in Info.plist. It is not a credential. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.345721268939-8hhh4gau0ditkr9anv2hqq0clpd43fnn</string>
			</array>
		</dict>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Lounge Locator uses your camera so you can take photos to attach to reviews and collections, and photograph your ID to verify you are 21 or over.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Lounge Locator uses your location to show nearby cigar lounges and center the map on where you are.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Lounge Locator uses your location to show nearby cigar lounges and center the map on where you are.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Lounge Locator uses your photo library so you can attach photos to reviews and collections, and upload a photo of your ID to verify you are 21 or over.</string>
	<key>RCTNewArchEnabled</key>
	<true/>
	<key>UIAppFonts</key>
	<array>
		<string>Inter-Medium.ttf</string>
		<string>PlayfairDisplay-SemiBold.ttf</string>
		<string>Inter-Bold.ttf</string>
		<string>Inter-Regular.ttf</string>
		<string>PlayfairDisplay-Regular.ttf</string>
		<string>Inter-SemiBold.ttf</string>
		<string>Ionicons.ttf</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
</dict>
</plist>
