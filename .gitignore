# fastlane
#
# It is recommended to not store the screenshots in the git repo. Instead, use fastlane to re-generate the
# screenshots whenever they are needed.
# For more information about the recommended setup visit:
# https://docs.fastlane.tools/best-practices/source-control/

**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots
**/fastlane/test_output

# Bundle artifact
*.jsbundle

# Ruby / CocoaPods
**/Pods/
/vendor/bundle/

# Temporary files created by Metro to check the health of the file watcher
.metro-health-check*

# testing
/coverage

# Firebase Admin SDK service account key — see scripts/seedFirestore.ts
# header comment. Never commit this; it grants full admin access to the
# Firebase project.
serviceAccountKey.json
**/serviceAccountKey.json

# Firebase client config — contains API keys, don't commit
android/app/google-services.json
ios/CigarLoungeApp/GoogleService-Info.plist
.scripts-build/

# Firebase CLI deploy cache — regenerated on every `firebase deploy`,
# machine-local, and a guaranteed conflict if two people ever commit it
.firebase/

# Yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Firebase CLI debug output — machine-local noise
firebase-debug.log
firestore-debug.log
ui-debug.log

# xcodebuild logs from local simulator builds
ios/*build.log

# Firestore emulator log, produced by `npm run test:rules`
firestore-debug.log
ui-debug.log
