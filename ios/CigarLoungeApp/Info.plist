<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Lounge Locator</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Google Sign-In redirect. Google opens a browser to authenticate and hands
	     the result back by opening this scheme, so without it the sign-in starts,
	     succeeds, and then never returns to the app.

	     The value is GoogleService-Info.plist's REVERSED_CLIENT_ID. That file is
	     gitignored because it carries the project's config, but this identifier is
	     deliberately duplicated here into a committed file: it is a public client
	     identifier, extractable from any installed copy of the app, and Apple
	     requires it declared in Info.plist. It is not a credential. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.345721268939-8hhh4gau0ditkr9anv2hqq0clpd43fnn</string>
			</array>
		</dict>
	</array>
	<!--
	  Remote notifications. Needed so an owner's phone can receive a reservation
	  or cancellation while the app is backgrounded — which is the entire point of
	  push. Without this the payload only arrives once the app is next opened,
	  which is what the in-app notification list already did.
	-->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!--
	  Voice search. BOTH keys are required and the app hard-crashes without
	  either — iOS does not prompt, it terminates. Speech recognition needs its
	  own permission on top of the microphone because the audio may leave the
	  device: Apple can transcribe on its servers rather than on-device, which is
	  also why public/privacy-policy.html names it.
	-->
	<key>NSMicrophoneUsageDescription</key>
	<string>Lounge Locator uses your microphone so you can search for lounges by speaking instead of typing.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Lounge Locator converts your speech to text so it can search for the lounge, city or brand you asked for. Nothing is recorded or kept.</string>
	<key>NSCameraUsageDescription</key>
	<string>Lounge Locator uses your camera so you can take photos to attach to reviews and collections, and photograph your ID to verify you are 21 or over.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Lounge Locator uses your location to show nearby cigar lounges and center the map on where you are.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Lounge Locator uses your location to show nearby cigar lounges and center the map on where you are.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Lounge Locator uses your photo library so you can attach photos to reviews and collections, and upload a photo of your ID to verify you are 21 or over.</string>
	<key>RCTNewArchEnabled</key>
	<true/>
	<key>UIAppFonts</key>
	<array>
		<string>Inter-Medium.ttf</string>
		<string>PlayfairDisplay-SemiBold.ttf</string>
		<string>Inter-Bold.ttf</string>
		<string>Inter-Regular.ttf</string>
		<string>PlayfairDisplay-Regular.ttf</string>
		<string>Inter-SemiBold.ttf</string>
		<string>Ionicons.ttf</string>
	</array>
	<!-- Lounge Locator has exactly one appearance: black and gold. Without
	     this the app follows the phone, so on a light-mode phone the in-app
	     alerts, action sheets and keyboards render light inside a black app.

	     It does NOT fix the light Map, which is what it was added for
	     (2026-09-15). Verified: the map still renders light with this set. The
	     map component is not at fault either — AIRMap is an MKMapView subclass,
	     the userInterfaceStyle prop reaches it, and react-native-maps' New
	     Architecture code does set overrideUserInterfaceStyle = Dark on it.
	     MKMapView on iOS 26.5 simply ignores that for its own tiles. The only
	     remaining route to a dark map on iOS is switching to the Google Maps
	     provider, which needs the Google Maps iOS SDK pod and a second API key.

	     Kept anyway: an app with one appearance should say so. -->
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
</dict>
</plist>
