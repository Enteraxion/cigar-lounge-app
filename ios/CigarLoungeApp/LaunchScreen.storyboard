<?xml version="1.0" encoding="UTF-8"?>
<!--
  The native launch screen: the very first frame after the icon is tapped,
  rendered by iOS before any JavaScript runs.

  Was the React Native template's default — "CigarLoungeApp" over "Powered by
  React Native" on a white background — which is what a member actually saw on
  every cold start, ahead of the branded splash in src/components/BrandSplash.
  A white flash into a black app also reads as a fault on its own.

  Now the logo centred on the palette's black, so it matches the splash that
  follows it and the icon that preceded it. Deliberately static: a launch screen
  cannot animate or run code, and iOS shows it for as long as the process takes
  to start. Anything that looks mid-animation would appear frozen.

  The image lives in Images.xcassets/LaunchLogo.imageset. Launch screens are
  cached aggressively by iOS — if a change here does not appear, delete the app
  from the device rather than assuming the edit failed.
-->
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="15702" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="01J-lp-oVM">
    <device id="retina4_7" orientation="portrait" appearance="light"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="15704"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--View Controller-->
        <scene sceneID="EHf-IW-A2E">
            <objects>
                <viewController id="01J-lp-oVM" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="Ze5-6b-2t3">
                        <rect key="frame" x="0.0" y="0.0" width="375" height="667"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView opaque="NO" clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="LaunchLogo" translatesAutoresizingMaskIntoConstraints="NO" id="LGO-01-img">
                                <rect key="frame" x="109.5" y="255.5" width="156" height="156"/>
                                <constraints>
                                    <constraint firstAttribute="width" constant="156" id="LGO-w1-156"/>
                                    <constraint firstAttribute="height" constant="156" id="LGO-h1-156"/>
                                </constraints>
                            </imageView>
                        </subviews>
                        <!-- theme.colors.primaryBlack (#050506). Hardcoded because a
                             storyboard cannot read the JS palette; keep in step with
                             src/theme if that value ever changes. -->
                        <color key="backgroundColor" red="0.019607843137254902" green="0.019607843137254902" blue="0.023529411764705882" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <constraint firstItem="LGO-01-img" firstAttribute="centerX" secondItem="Ze5-6b-2t3" secondAttribute="centerX" id="LGO-cx-001"/>
                            <constraint firstItem="LGO-01-img" firstAttribute="centerY" secondItem="Ze5-6b-2t3" secondAttribute="centerY" id="LGO-cy-001"/>
                        </constraints>
                        <viewLayoutGuide key="safeArea" id="Bcu-3y-fUS"/>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="iYj-Kq-Ea1" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="52.173913043478265" y="375"/>
        </scene>
    </scenes>
    <resources>
        <image name="LaunchLogo" width="156" height="156"/>
    </resources>
</document>
